{
  "expo": {
    "name": "StayUp",
    "slug": "stayup-mobile",
    "version": "1.17.1",
    "scheme": "stayup",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.r-sik.stayup-mobile"
    },
    "android": {
      "package": "dev.r_sik.stayupmobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1119"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E1119"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
